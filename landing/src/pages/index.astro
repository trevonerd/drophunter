---
import LogoMark from "../components/LogoMark.astro";
import ShotPicture from "../components/ShotPicture.astro";
import Sponsor from "../components/Sponsor.astro";
import TrustStrip from "../components/TrustStrip.astro";
import VideoFacade from "../components/VideoFacade.astro";
import Layout from "../layouts/Layout.astro";
import { FEATURES, FAQS, SCREENSHOTS, SITE } from "../site";

const title = "DropHunter by Trevisoft | Auto Claim Twitch Drops";
const description = SITE.description;
const shots = Object.fromEntries(SCREENSHOTS.map((s) => [s.id, s])) as Record<
  (typeof SCREENSHOTS)[number]["id"],
  (typeof SCREENSHOTS)[number]
>;
const featured = shots["popup-farming"] ?? SCREENSHOTS[0];
const monitor = shots["monitor"] ?? SCREENSHOTS[2];
---

<Layout title={title} description={description}>
  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <div class="logo-lockup">
            <LogoMark />
            <p class="wordmark">
              <span>DropHunter</span>
              <em>by Trevisoft</em>
            </p>
          </div>
          <h1 class="lede">{SITE.tagline}</h1>
          <p class="sub">{SITE.subhead}</p>
          <div class="hero-actions">
            <a class="btn btn-primary btn-lg" href={SITE.storeUrl} rel="noopener">{SITE.cta}</a>
          </div>
          <TrustStrip />
        </div>
        <div class="stage">
          <div class="glow-ring"></div>
          <figure class="shot-hero" data-tilt>
            <div class="chrome-bar" aria-hidden="true"><i></i><span>DropHunter popup</span></div>
            <ShotPicture shot={featured} fetchpriority="high" />
          </figure>
          <figure class="shot-monitor" data-tilt>
            <div class="chrome-bar" aria-hidden="true"><i></i><span>Live monitor</span></div>
            <ShotPicture shot={monitor} loading="lazy" />
          </figure>
        </div>
      </div>
    </section>

    <VideoFacade />

    <section class="section" id="features" aria-labelledby="features-title">
      <div class="wrap">
        <h2 id="features-title" class="sr-only">Main features</h2>
        <div class="feature-grid">
          {
            FEATURES.map((feature) => {
              const shot = shots[feature.shot];
              return (
                <article class="feature-card" data-reveal>
                  <figure>
                    <ShotPicture
                      shot={shot}
                      loading="lazy"
                      sizes="(max-width: 640px) calc(100vw - 3.5rem), 640px"
                    />
                  </figure>
                  <div class="feature-copy">
                    <h3>{feature.title}</h3>
                    <p>{feature.body}</p>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="section section-tight" id="faq" aria-labelledby="faq-title">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <h2 id="faq-title">Questions</h2>
        </div>
        <div class="faq">
          {
            FAQS.map((item) => (
              <details data-reveal>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="install" aria-labelledby="install-title">
      <div class="wrap">
        <div class="cta-band" data-reveal>
          <h2 id="install-title">Queue it. Start it. Come back later.</h2>
          <p>Free for Chrome and Edge.</p>
          <div class="cta-actions">
            <a class="btn btn-primary btn-lg" href={SITE.storeUrl} rel="noopener">{SITE.cta}</a>
          </div>
        </div>
      </div>
    </section>

    <Sponsor />
  </main>
</Layout>
