---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../site";

const title = "Page not found — DropHunter by Trevisoft";
const description = "That URL is not part of the DropHunter site. Head back to getdrophunter.com.";
---

<Layout title={title} description={description}>
  <main id="main" class="section">
    <div class="wrap" style="min-height: 50vh; padding-top: 3rem;">
      <p class="eyebrow">404</p>
      <h1 class="lede">This page is not in the queue.</h1>
      <p class="sub">The DropHunter site is a single page. You probably want the homepage.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/">Back to DropHunter</a>
        <a class="btn btn-ghost" href={SITE.storeUrl} rel="noopener">Chrome Web Store</a>
      </div>
    </div>
  </main>
</Layout>
