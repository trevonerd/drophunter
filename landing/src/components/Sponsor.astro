---
import { SITE } from "../site";
---

<aside class="section section-tight" id="sponsored" aria-labelledby="sponsored-title">
  <div class="wrap">
    <div class="sponsor" data-reveal>
      <p id="sponsored-title" class="sponsor-label">Sponsored</p>
      <p class="sponsor-name">
        <a href={SITE.twitchUrl} rel="noopener" target="_blank">{SITE.twitchChannel}</a>
      </p>
      <p class="sponsor-meta">Independent Twitch channel</p>
    </div>
  </div>
</aside>
