---
interface Props {
  shot: {
    src: string;
    fallback: string;
    alt: string;
    width: number;
    height: number;
  };
  fetchpriority?: "high" | "low" | "auto";
  loading?: "lazy" | "eager";
}

const { shot, fetchpriority, loading } = Astro.props;
---

<picture>
  <source srcset={`${shot.src} 2x`} type="image/webp" />
  <img
    src={shot.fallback}
    srcset={`${shot.fallback} 2x`}
    alt={shot.alt}
    width={shot.width}
    height={shot.height}
    fetchpriority={fetchpriority}
    loading={loading}
    decoding="async"
    style={`max-width:min(100%,${shot.width}px)`}
  />
</picture>
