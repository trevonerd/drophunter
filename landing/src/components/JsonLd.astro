---
import { FAQS, FEATURE_LIST, SITE, VIDEO } from "../site";

const software = {
  "@type": "SoftwareApplication",
  "@id": `${SITE.url}/#app`,
  name: SITE.brand,
  alternateName: [SITE.name, "DropHunter Trevisoft", "Twitch Drops farmer extension"],
  url: SITE.url,
  downloadUrl: SITE.storeUrl,
  installUrl: SITE.storeUrl,
  applicationCategory: "BrowserApplication",
  applicationSubCategory: "Browser extension",
  operatingSystem: "Chrome, Chromium, Brave, Microsoft Edge",
  browserRequirements: "Requires Chrome 120 or later, Brave, or Microsoft Edge",
  softwareVersion: SITE.version,
  releaseNotes: `${SITE.githubUrl}/releases`,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: SITE.storeUrl,
  },
  isAccessibleForFree: true,
  description: SITE.description,
  screenshot: `${SITE.url}/images/screenshots/popup-farming.png`,
  image: `${SITE.url}/images/og.png`,
  featureList: [...FEATURE_LIST],
  author: { "@id": `${SITE.url}/#person` },
  creator: { "@id": `${SITE.url}/#person` },
  publisher: { "@id": `${SITE.url}/#org` },
  maintainer: { "@id": `${SITE.url}/#org` },
  copyrightHolder: { "@id": `${SITE.url}/#org` },
  license: SITE.githubUrl,
  codeRepository: SITE.githubUrl,
  sameAs: [SITE.githubUrl],
  keywords:
    "auto claim Twitch Drops, Twitch Drops farmer, Twitch Drops extension Chrome, DropHunter by Trevisoft",
  additionalType: "https://schema.org/WebApplication",
};

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE.url}/#org`,
      name: SITE.orgName,
      url: SITE.orgUrl,
      sameAs: [SITE.githubUrl, SITE.authorUrl],
      founder: { "@id": `${SITE.url}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${SITE.url}/#person`,
      name: SITE.authorName,
      url: SITE.authorUrl,
      affiliation: { "@id": `${SITE.url}/#org` },
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#site`,
      url: SITE.canonical,
      name: SITE.brand,
      description: SITE.description,
      inLanguage: "en",
      publisher: { "@id": `${SITE.url}/#org` },
    },
    {
      "@type": "WebPage",
      "@id": `${SITE.url}/#page`,
      url: SITE.canonical,
      name: "Auto Claim Twitch Drops | DropHunter",
      description: SITE.description,
      isPartOf: { "@id": `${SITE.url}/#site` },
      about: { "@id": `${SITE.url}/#app` },
      primaryImageOfPage: `${SITE.url}/images/og.png`,
      video: { "@id": `${SITE.url}/#promo` },
    },
    {
      "@type": "WebApplication",
      "@id": `${SITE.url}/#webapp`,
      name: SITE.brand,
      url: SITE.url,
      applicationCategory: "BrowserApplication",
      operatingSystem: "Chrome",
      offers: software.offers,
      author: { "@id": `${SITE.url}/#person` },
      downloadUrl: SITE.storeUrl,
    },
    software,
    {
      "@type": "VideoObject",
      "@id": `${SITE.url}/#promo`,
      name: VIDEO.name,
      description: VIDEO.description,
      thumbnailUrl: VIDEO.thumbnailUrl,
      uploadDate: VIDEO.uploadDate,
      embedUrl: VIDEO.embedUrl,
      contentUrl: VIDEO.contentUrl,
      publisher: { "@id": `${SITE.url}/#org` },
      isPartOf: { "@id": `${SITE.url}/#page` },
    },
    {
      "@type": "FAQPage",
      "@id": `${SITE.url}/#faq`,
      mainEntity: FAQS.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
