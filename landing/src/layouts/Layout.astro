---
import JsonLd from "../components/JsonLd.astro";
import LogoMark from "../components/LogoMark.astro";
import { SELINE, selineEvent } from "../seline";
import { SITE, withUtm } from "../site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = SITE.canonical;
const og = `${SITE.url}/images/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="auto claim Twitch Drops, Twitch Drops farmer, Twitch Drops extension Chrome, farm Twitch Drops automatically, DropHunter by Trevisoft"
    />
    <meta name="author" content={`${SITE.authorName} / ${SITE.orgName}`} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#0e0e10" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DropHunter by Trevisoft. Auto-claim Twitch Drops." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content="DropHunter by Trevisoft. Auto-claim Twitch Drops." />
    <JsonLd />
    <script
      is:inline
      async
      src={SELINE.scriptSrc}
      data-token={SELINE.token}
      data-api-host={SELINE.apiHost}></script>
  </head>
  <body>
    <canvas id="loot" aria-hidden="true"></canvas>
    <div id="cursor-glow" aria-hidden="true"></div>
    <a
      class="skip"
      href="#main"
      {...selineEvent("nav: section clicked", { placement: "nav", section: "main", id: "skip-main" })}
    >Skip to content</a>
    <header class="nav">
      <div class="nav-inner">
        <a
          class="brand"
          href="/"
          aria-label="DropHunter by Trevisoft home"
          {...selineEvent("nav: home clicked", { placement: "nav", id: "nav-home" })}
        >
          <LogoMark class="nav-mark" title="" uid="nav" />
          <span>
            DropHunter
            <small>by Trevisoft</small>
          </span>
        </a>
        <div class="nav-cta">
          <a
            class="btn btn-ghost"
            href={withUtm(SITE.githubUrl, "github")}
            {...selineEvent("github: clicked", { placement: "nav", id: "github-nav" })}
          >GitHub</a>
          <a
            class="btn btn-primary"
            href={withUtm(SITE.storeUrl, "nav")}
            rel="noopener"
            {...selineEvent("cta: add to chrome", { placement: "nav", id: "cta-nav" })}
          >Add to Chrome</a>
        </div>
      </div>
    </header>
    <slot />
    <footer>
      <div class="wrap foot">
        <div>
          <p>
            © {new Date().getFullYear()}{" "}
            <a
              href={withUtm(SITE.orgUrl, "trevisoft", "footer")}
              rel="noopener"
              target="_blank"
              {...selineEvent("footer: trevisoft clicked", { placement: "footer", id: "footer-trevisoft" })}
            >{SITE.orgName}</a>. Developed by{" "}
            <a
              href={withUtm(SITE.authorSiteUrl, "marcotrevisani", "footer")}
              rel="noopener"
              target="_blank"
              {...selineEvent("footer: marco trevisani clicked", {
                placement: "footer",
                id: "footer-marcotrevisani",
              })}
            >{SITE.authorName}</a>.
          </p>
          <p class="disclaimer">{SITE.disclaimer}</p>
        </div>
        <nav aria-label="Footer">
          <a
            href={withUtm(SITE.storeUrl, "footer_store")}
            rel="noopener"
            {...selineEvent("cta: add to chrome", { placement: "footer", id: "cta-footer-store" })}
          >Chrome Web Store</a>
          <a
            href={withUtm(SITE.githubUrl, "github")}
            {...selineEvent("github: clicked", { placement: "footer", id: "github-footer" })}
          >Source</a>
          <a
            href={withUtm(SITE.privacyUrl, "privacy")}
            {...selineEvent("privacy: opened", { placement: "footer", id: "privacy-footer" })}
          >Privacy</a>
          <a
            href={withUtm(SITE.orgUrl, "trevisoft", "footer")}
            rel="noopener"
            target="_blank"
            {...selineEvent("footer: trevisoft clicked", { placement: "footer", id: "footer-trevisoft" })}
          >{SITE.orgName}</a>
          <a
            href="/llms.txt"
            {...selineEvent("footer: llms.txt clicked", { placement: "footer", id: "llms-footer" })}
          >llms.txt</a>
        </nav>
      </div>
    </footer>
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
