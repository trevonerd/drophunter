{
  "name": "drophunter",
  "private": true,
  "version": "4.0.4",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trevonerd/drophunter/"
  },
  "scripts": {
    "preinstall": "bun -e \"const ua=process.env.npm_config_user_agent||'';if(!ua.startsWith('bun/')){console.error('Use Bun: run bun install.');process.exit(1)}\"",
    "clean": "wxt clean && rm -rf dist video/out",
    "dev": "wxt -b chrome",
    "dev:chrome": "wxt -b chrome",
    "dev:edge": "wxt -b edge",
    "build": "bun run build:chrome",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:all": "bun run build:chrome && bun run build:edge",
    "zip": "bun run zip:chrome",
    "zip:chrome": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge",
    "zip:all": "bun run zip:chrome && bun run zip:edge",
    "check": "bun run test:ts && bun run lint && bun run test && bun run build:all",
    "release:check": "bun scripts/release-check.mjs",
    "release:zip": "bun run release:check && bun run zip:all",
    "video:install": "cd video && bun install",
    "video:preview": "cd video && bun run preview",
    "video:render:cta": "cd video && bun run render:cta",
    "video:render:cta:4k": "cd video && bun run render:cta:4k",
    "video:still:cta": "cd video && bun run still:cta",
    "video:still:cta:4k": "cd video && bun run still:cta:4k",
    "video:render:promo": "cd video && bun run render:promo",
    "video:render:promo:4k": "cd video && bun run render:promo:4k",
    "video:still:promo": "cd video && bun run still:promo",
    "video:still:promo:4k": "cd video && bun run still:promo:4k",
    "test:ts": "tsc --noEmit",
    "check:typescript-scope": "bun scripts/check-typescript-change-scope.ts",
    "test": "bun test tests/",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "deps:outdated": "bun outdated && cd video && bun outdated",
    "deps:audit": "bun audit",
    "deps:audit:all": "bun audit && cd video && bun audit",
    "update": "bun update --latest && bun install && cd video && bun update --latest && bun install",
    "update:interactive": "bun update --interactive --latest && bun install && cd video && bun update --interactive --latest && bun install",
    "update:safe": "bun update && bun install",
    "update:safe:all": "bun update && bun install && cd video && bun update && bun install",
    "deps:list": "bun pm ls",
    "deps:cache:clear": "bun pm cache rm",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "postinstall": "wxt prepare",
    "prepare": "husky"
  },
  "dependencies": {
    "brace-expansion": "^5.0.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/chrome": "0.2.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.5.2",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "postcss": "8.5.25",
    "react-grab": "^0.1.50",
    "react-scan": "^0.5.7",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wxt": "0.20.27"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "adm-zip": "^0.6.0",
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.18",
    "postcss": "8.5.25",
    "shell-quote": "^1.10.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "vite": "^8.2.0"
  }
}
